# Gemini / Google Generative AI
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Supabase PostgreSQL (SQLAlchemy format)
# Project → Settings → Database → Connection string (URI)
# Example: postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=

# Optional overrides
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
MAX_AGENT_RETRIES=3
DOCKER_IMAGE=python:3.11-slim
DOCKER_TIMEOUT_SECONDS=15
DOCKER_MEMORY_LIMIT=512m
DOCKER_VENDOR_VOLUME=adas_sandbox_vendor
